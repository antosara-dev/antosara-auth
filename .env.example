# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

MODE=DEV

# Email Configuration (AWS SES)
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_HOST_USER=YOUR_AWS_SES_ACCESS_KEY_ID
EMAIL_HOST_PASSWORD=YOUR_AWS_SES_SECRET_ACCESS_KEY
EMAIL_HOST_PORT=587
EMAIL_SENDER=no-reply@yourdomain.com

# Application Configuration
HOST_NAME=localhost

# JWT Configuration
JWT_EXPIRY_HOURS=24  # Token expiry time in hours
JWT_ALGORITHM=RS256
JWT_ISSUER=https://localhost
JWT_TYPE=access

# RSA Private Key (for RS256 signing)
# Generate using: scripts/generate-rsa-keys.sh or scripts/generate-rsa-keys.ps1
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
YOUR_PRIVATE_KEY_HERE
-----END RSA PRIVATE KEY-----"

# RSA Public Key (for RS256 verification)
# Can be derived from private key, but can also be set separately for key rotation
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
YOUR_PUBLIC_KEY_HERE
-----END PUBLIC KEY-----"

# Optional: Multiple public keys for key rotation (multiple PEM blocks)
# JWT_PUBLIC_KEYS="-----BEGIN PUBLIC KEY-----\nKEY1\n-----END PUBLIC KEY-----\n-----BEGIN PUBLIC KEY-----\nKEY2\n-----END PUBLIC KEY-----"

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=users
AWS_REGION=us-west-2

# For local DynamoDB testing
DYNAMODB_ENDPOINT=http://localhost:8000

# CORS Configuration (comma-separated list)
# CORS_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com

# Cookie Configuration (for cross-subdomain authentication)
# COOKIE_DOMAIN=.yourdomain.com

# Rate Limiting
# RATE_LIMIT_REQUESTS_PER_MINUTE=60
