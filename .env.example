# Environment Variables for Antosara Auth Service
# Add these variables to your environment or AWS Secrets Manager.
# NEVER commit .env to version control!

# AWS Secrets Manager: secret name or ARN. The app fetches this secret and
# loads all key-value pairs into the environment (required).
# AWS_SECRET_ARN=my-app/prod
# AWS_SECRET_NAME=my-app/prod

# Email Configuration (AWS SES)
EMAIL_HOST=YOUR_AWS_SES_SMTP_HOST
EMAIL_HOST_USER=YOUR_AWS_SES_ACCESS_KEY_ID
EMAIL_HOST_PASSWORD=YOUR_AWS_SES_SECRET_ACCESS_KEY
EMAIL_HOST_PORT=587
EMAIL_SENDER=no-reply@yourdomain.com

# Application Configuration
HOST_NAME=yourdomain.com

# JWT Configuration
JWT_EXPIRY_HOURS=24  # Token expiry time in hours
JWT_ALGORITHM=RS256
JWT_ISSUER=https://yourdomain.com
JWT_TYPE=access

# RSA Private Key (for RS256 signing)
# Generate using: scripts/generate-rsa-keys.sh or scripts/generate-rsa-keys.ps1
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
YOUR_PRIVATE_KEY_HERE
-----END RSA PRIVATE KEY-----"

# RSA Public Key (for RS256 verification). One private key has exactly one public key.
# Derive from current private key: openssl rsa -in jwt_private_key.pem -pubout -out jwt_public_key.pem
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
YOUR_PUBLIC_KEY_HERE
-----END PUBLIC KEY-----"

# Optional: Multiple public keys for key rotation (multiple key pairs, not multiple keys from one private).
# During rotation you sign with one private key but expose current + previous public keys so old tokens still verify.
# Format: concatenate PEM blocks. Example with two key pairs:
#   openssl rsa -in current_private.pem -pubout  &&  openssl rsa -in previous_private.pem -pubout
# JWT_PUBLIC_KEYS="-----BEGIN PUBLIC KEY-----\nKEY1\n-----END PUBLIC KEY-----\n-----BEGIN PUBLIC KEY-----\nKEY2\n-----END PUBLIC KEY-----"

# DynamoDB Configuration
AWS_REGION=us-west-2

# CORS Configuration (comma-separated list)
# CORS_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com

# Cookie Configuration (for cross-subdomain authentication)
# COOKIE_DOMAIN=.yourdomain.com

# Rate Limiting
# RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Password reset URL. The parameter 'token' will be appended to the URL.
# This page is expected to be a simple HTML page with a form that allows the user to enter a new password.
# The form should have the following fields:
# - Password
# - Confirm Password
# A POST request should be submitted to the /api/reset-password/confirm endpoint 
# with the token and password in the body.
# The endpoint returns a 200 OK response if the password is reset successfully.

# PASSWORD_RESET_URL=https://yourdomain.com/new-password.html
